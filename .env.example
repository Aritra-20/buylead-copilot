# Pick ONE provider. Set its key (export / $env: in PowerShell, or Streamlit secrets).
# BUYLEAD_PROVIDER is optional: if unset, whichever key is present is used.
BUYLEAD_PROVIDER=gemini

# Gemini (free tier key from https://aistudio.google.com/apikey)
GEMINI_API_KEY=
# Optional throttle (requests/min) - set 10 on a free-tier key; leave empty on a paid key
BUYLEAD_RPM=

# Claude (https://console.anthropic.com)
ANTHROPIC_API_KEY=

# Optional overrides: model id, and USD price per million tokens for cost-per-query in evals
# Defaults: claude-haiku-5-5 (anthropic) / gemini-3.5-flash-lite (gemini)
BUYLEAD_MODEL=
BUYLEAD_PRICE_IN=
BUYLEAD_PRICE_OUT=

# Retrieval in LLM mode: gemini (neural, default with a Gemini key) or tfidf
BUYLEAD_EMBEDDINGS=
# Optional override; normally set by `python -m buylead.tune` (data/embedding_threshold.json)
BUYLEAD_EMBED_THRESHOLD=

# Public demo cost guardrails
BUYLEAD_SESSION_LIMIT=20
BUYLEAD_DAILY_BUDGET_USD=0.25
